# Copy this file to .env.local and fill in the values.
# .env.local is ignored by Git. Never commit real keys.

# Public URL of the site, used for links in emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk (https://dashboard.clerk.com > your application > API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase (https://supabase.com/dashboard > your project > Project Settings)
# Data API: the project URL. API Keys: the publishable and the secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Resend (https://resend.com/api-keys)
# onboarding@resend.dev only delivers to your own Resend account address.
# Use an address on a domain verified in Resend before going to production.
RESEND_API_KEY=
EMAIL_FROM="LiteLaunch <onboarding@resend.dev>"

# Lemon Squeezy (https://app.lemonsqueezy.com)
# API key: Settings > API. Store ID: Settings > Stores (the number after #).
# Variant ID: open the product, then the "..." menu of the variant > Copy ID.
# Webhook secret: any random string; use the same one in Settings > Webhooks.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
